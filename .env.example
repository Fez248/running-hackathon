# Single source of configuration for the whole monorepo: Prisma CLI commands
# load this repository-root file via dotenv-cli, and at runtime libs/db finds it
# by walking up from the working directory. Run `npm run env:init` to create
# .env from this template.
#
# The SQLite path is resolved relative to libs/db/prisma/schema.prisma, so
# "file:./dev.db" means libs/db/prisma/dev.db no matter which workspace runs.
#
# Point DATABASE_URL at a remote libSQL/Turso database (libsql://...) to use the
# libSQL driver adapter instead of the local file; TURSO_AUTH_TOKEN is then required.
DATABASE_URL="file:./dev.db"

# Only for remote libSQL/Turso databases. Never commit a real token.
# TURSO_AUTH_TOKEN=""

# Local-only convenience: when true, the tRPC context trusts an
# `x-sidewalk-user` request header to identify the contributor. It is
# impersonation by design, so it must stay false outside local development.
SIDEWALK_DEV_AUTH="false"

# Server-side scanning of a RAW phone recording uploaded in the scan panel. The
# web app runs on Node and cannot scan a recording itself, so it forwards the
# upload to a worker that runs the Python detector:
#
#   (cd apps/bridge && uv run python -m bridge.worker --port 8787)
#   SCAN_WORKER_URL="http://127.0.0.1:8787/scan"
#
# Unset (the default) is a supported deployment: the panel says raw scanning is
# unavailable here and prints the exact CLI command to run instead, and the JSON
# upload keeps working. See docs/RAW_SCAN_UPLOAD.md.
# SCAN_WORKER_URL=""
# SCAN_WORKER_TOKEN=""
# SCAN_WORKER_MAX_UPLOAD_BYTES="67108864"
# SCAN_WORKER_TIMEOUT_MS="120000"
