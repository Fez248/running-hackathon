// Sidewalk Map — hackathon schema.
// SQLite has no spatial types, so coordinates are plain floats and viewport
// queries use indexed lat/lng range scans.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local development default. Remote libSQL/Turso databases are reached through the
  // libSQL driver adapter (see src/client.ts and prisma.config.ts), which replaces this
  // url; Prisma still requires a `file:` value here to validate the schema.
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(cuid())
  handle      String   @unique
  displayName String?
  /// WHEELCHAIR | STROLLER | COURIER | DELIVERY_ROBOT
  profile     String?
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  reports Report[]
  votes   Vote[]
  traces  Trace[]
}

/// A single crowdsourced observation, usually captured while moving.
model Report {
  id        String @id @default(cuid())
  lat       Float
  lng       Float
  /// Snapped grid cell (see @sidewalk/core gridKey) used to cluster duplicates.
  gridKey   String
  /// CURB | STEPS | ROADWORKS | CROSSING | NARROW_PATH | BLOCKED | STEEP_SLOPE | ROUGH_SURFACE
  kind      String
  /// PASSABLE | DIFFICULT | IMPASSABLE | UNKNOWN
  passability String @default("UNKNOWN")
  heightCm  Int?
  widthCm   Int?
  note      String?
  photoUrl  String?
  accuracyM Float?
  /// Profile of the reporter at capture time.
  capturedByProfile String?
  /// MANUAL | VOICE | SENSOR — how the observation was captured.
  source    String  @default("MANUAL")
  /// Raw dictated utterance for a VOICE report, kept for auditing the parser.
  transcript String?
  /// How well the server's parser understood a VOICE transcript, 0..1.
  parseConfidence Float?
  /// When a reviewer decided a queued VOICE report; null while it waits.
  reviewedAt DateTime?
  /// Reviewer's note on a rejected parse, for auditing the parser's failures.
  reviewNote String?
  /// Idempotency key from the client so offline replays do not duplicate.
  clientReportId String? @unique

  agreeCount    Int   @default(0)
  disagreeCount Int   @default(0)
  confidence    Float @default(0.5)
  status        String @default("ACTIVE") // ACTIVE | PENDING_REVIEW | RESOLVED | REJECTED

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  traceId String?
  trace   Trace?  @relation(fields: [traceId], references: [id], onDelete: SetNull)

  /// Detector confidence of a SENSOR report, kept apart from `confidence` so a
  /// vote recomputing the crowd/GPS part cannot drop the detector's own doubt.
  detectorConfidence Float?
  /// Bridge scan a SENSOR report was derived from.
  surfaceScanId String?
  surfaceScan   SurfaceScan? @relation(fields: [surfaceScanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes Vote[]

  @@index([lat, lng])
  @@index([kind])
  @@index([gridKey])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([surfaceScanId])
}

/// A floor-imperfection scan produced by `apps/bridge` from a phone IMU + GPS
/// recording. Kept even when the capture is unusable, so a rejected upload is
/// auditable instead of silently disappearing.
model SurfaceScan {
  id       String @id @default(cuid())
  /// Idempotency key from the bridge payload; a re-upload resolves to this row.
  clientScanId String @unique
  /// Recording the scan was run on (directory or archive name).
  source   String
  /// Recording layout the bridge ingester recognised (sensor_logger | csv | ...).
  format   String
  /// ok | degraded | unusable — capture-quality gate verdict.
  verdict  String
  /// Full capture certificate as JSON (see @sidewalk/core captureQualitySchema).
  quality  String
  cadenceSpm Float @default(0)
  /// Findings reported by the detector, before the quality gate is applied.
  findingCount Int @default(0)
  /// Reports actually created from this scan (0 for an unusable capture).
  reportCount  Int @default(0)

  uploadedById String?

  createdAt DateTime @default(now())

  reports Report[]

  @@index([createdAt])
}

/// Confirm / dispute signal from another contributor.
model Vote {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  agree    Boolean
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
}

/// A run/ride session; reports captured during it hang off the trace.
model Trace {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Encoded polyline or JSON array of [lat, lng, t] points.
  path      String
  distanceM Float    @default(0)
  startedAt DateTime @default(now())
  endedAt   DateTime?

  reports Report[]
  cells   CoverageCell[]

  @@index([userId])
}

/// A fog-of-war cell revealed by walking/running through it.
/// `cellKey` comes from @sidewalk/core fogCellKey, so the grid is identical on
/// every client and the key is the natural unique index SQLite can serve.
model CoverageCell {
  id        String @id @default(cuid())
  cellKey   String @unique
  /// Cell centre, denormalised so viewport queries stay indexed range scans.
  lat       Float
  lng       Float
  /// How many accepted GPS fixes have landed in this cell.
  visits    Int    @default(1)
  /// GPS accuracy in metres of the batch that first revealed this cell.
  bestAccuracyM Float?

  traceId String?
  trace   Trace?  @relation(fields: [traceId], references: [id], onDelete: SetNull)

  userId String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([lat, lng])
  @@index([traceId])
}
