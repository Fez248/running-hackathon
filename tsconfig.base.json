{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "paths": {
      "@sidewalk/core": [
        "./libs/core/src/index.ts"
      ],
      "@sidewalk/core/*": [
        "./libs/core/src/*"
      ],
      "@sidewalk/db": [
        "./libs/db/src/index.ts"
      ],
      "@sidewalk/db/*": [
        "./libs/db/src/*"
      ],
      "@sidewalk/api": [
        "./libs/api/src/index.ts"
      ],
      "@sidewalk/api/*": [
        "./libs/api/src/*"
      ]
    }
  }
}
